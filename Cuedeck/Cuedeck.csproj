<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console window on Windows. Program attaches to the launching terminal's console when there is one. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>Cuedeck</AssemblyName>
    <Product>Cuedeck</Product>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- What the app is, for its file's Properties in Explorer, the version switch, the title bar and the options' About
         tab. Raise the version for each release; the build adds the commit it was made from to the informational version. -->
    <Version>1.0.0</Version>
    <AssemblyTitle>Cuedeck Lighting Controller</AssemblyTitle>
    <Description>DMX lighting controller for Windows: cues, chases, effects and faders over a patch of real fixtures, a live 3D visualizer, and light shows for each song played live with VirtualDJ or Cuepoint.</Description>
    <Authors>Steve 'Sly' Williams</Authors>
    <Company>Konaju Games</Company>
    <Copyright>Copyright (c) 2026 Steve 'Sly' Williams</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/KonajuGames/cuedeck-lighting-controller</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The executable's icon in Explorer and the taskbar; Assets\make_logo.py makes it from the logo. -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- For the options' About tab, which reads them back from the assembly. -->
    <AssemblyMetadata Include="License" Value="$(PackageLicenseExpression)" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- A release package (dotnet publish -r win-x64, as tools\package.ps1 does) carries the .NET runtime with it, so
         it runs on a computer without .NET installed. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Logging" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Mixer" Version="2026.10.3" />
    <!-- WASAPI audio input for Sound Reactive, the version Cuepoint uses. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- GLSL is compiled to SPIR-V at startup, so the sources ship next to the executable. -->
    <None Include="Shaders\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The bundled fixture library (from the Open Fixture Library, via sLight), read from beside the executable. -->
    <None Include="Fixtures\Library\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Images, by file name; Assets\draw_assets.py and Assets\make_logo.py draw them. -->
    <EmbeddedResource Include="Assets\*.png" Exclude="Assets\logo-source.png;Assets\preview-*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window, rendering and UI code the Cue apps share (BRUTAL's GLFW, Vulkan, FreeType and the rest come with
         it). It's a sibling checkout: cue-framework beside this repository. -->
    <ProjectReference Include="..\..\cue-framework\Cue.Framework\Cue.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ByteSize, ElementCount, Ptr and friends. -->
    <Using Include="Brutal" />
    <!-- The framework's, everywhere, as if its classes were the app's own. -->
    <Using Include="Cue.Framework" />
    <Using Include="Cue.Framework.Rendering" />
    <Using Include="Cue.Framework.UI" />
    <Using Include="Cue.Framework.Window" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach the app's own classes, which are internal to it. -->
    <InternalsVisibleTo Include="Cuedeck.Tests" />
  </ItemGroup>

</Project>
