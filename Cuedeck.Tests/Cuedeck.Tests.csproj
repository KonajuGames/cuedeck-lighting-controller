<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cuedeck\Cuedeck.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden scenario's show, and sLight's output for it (see Golden/GoldenScenario.cs). -->
    <None Include="Golden\*.slight;Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Brutal" />
    <!-- The framework's, everywhere, as if its classes were the app's own. -->
    <Using Include="Cue.Framework" />
    <Using Include="Cue.Framework.Rendering" />
    <Using Include="Cue.Framework.UI" />
    <Using Include="Cue.Framework.Window" />
  </ItemGroup>

</Project>
